{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "lib": ["es2019", "dom"],
    "allowJs": false,
    "jsx": "react-jsx",
    "declaration": false,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "src",
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
